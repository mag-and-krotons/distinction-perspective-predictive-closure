\setlength{\tabcolsep}{5pt}
\captionsetup{font=small,labelfont={bf,sf,color=SeriesMaroon},textfont=it,justification=raggedright,singlelinecheck=false,skip=6pt}

\providecommand{\PaperCode}{P00}
\providecommand{\PaperKind}{RESEARCH PAPER}
\providecommand{\PaperVersion}{VERSION 1.0}
\providecommand{\PaperDate}{AUGUST 2026}
\providecommand{\PaperTitle}{Untitled Paper}
\providecommand{\PaperSubtitle}{}
\providecommand{\PaperFullTitle}{\PaperTitle}
\providecommand{\PaperShortTitle}{\PaperTitle}
\providecommand{\PaperKeywords}{}
\providecommand{\PaperClassification}{}
\providecommand{\PaperCitation}{}
\providecommand{\PaperDOI}{}

\AtBeginDocument{\hypersetup{pdftitle={\PaperFullTitle},pdfauthor={Abhijit Singh},pdfsubject={\PaperKind\ \PaperCode}}}

\fancypagestyle{series}{%
  \fancyhf{}
  \fancyhead[L]{\sffamily\fontsize{8.5}{10}\selectfont\color{SeriesGray}\MakeUppercase{\PaperShortTitle}}
  \fancyhead[R]{\sffamily\fontsize{8.5}{10}\selectfont\color{SeriesGray}\PaperCode}
  \fancyfoot[C]{\sffamily\fontsize{8.5}{10}\selectfont\color{SeriesInk}\thepage}
  \renewcommand{\headrulewidth}{.35pt}
  \renewcommand{\footrulewidth}{0pt}}
\pagestyle{series}

\titleformat{\part}[block]
  {\sffamily\bfseries\color{SeriesMaroon}\fontsize{16}{19}\selectfont}
  {Part \thepart}{.8em}{}
  [\vspace{.35ex}\color{SeriesLight}\titlerule]
\titlespacing*{\part}{0pt}{2.5ex plus .6ex minus .3ex}{1.3ex}
\titleformat{\section}[hang]
  {\sffamily\bfseries\color{SeriesInk}\fontsize{17}{20}\selectfont}
  {\thesection}{1.1em}{}
  [\vspace{.35ex}\color{SeriesLight}\titlerule]
\titlespacing*{\section}{0pt}{3.0ex plus .7ex minus .4ex}{1.25ex}
\titleformat{name=\section,numberless}[block]
  {\sffamily\bfseries\color{SeriesInk}\fontsize{17}{20}\selectfont}
  {}{0pt}{}
  [\vspace{.35ex}\color{SeriesLight}\titlerule]
\titlespacing*{name=\section,numberless}{0pt}{2.5ex plus .6ex minus .3ex}{1.2ex}
\titleformat{\subsection}[hang]
  {\sffamily\bfseries\color{SeriesMaroon}\fontsize{12.5}{15}\selectfont}
  {\thesubsection}{.8em}{}
\titlespacing*{\subsection}{0pt}{2.2ex plus .5ex minus .3ex}{.8ex}
\titleformat{\subsubsection}[hang]
  {\sffamily\bfseries\color{SeriesInk}\fontsize{10.8}{13}\selectfont}
  {\thesubsubsection}{.75em}{}
\titlespacing*{\subsubsection}{0pt}{1.8ex plus .4ex minus .2ex}{.5ex}
\titleformat{\paragraph}[runin]
  {\sffamily\bfseries\color{SeriesInk}}
  {}{0pt}{}[.]

\newtheoremstyle{seriesplain}{6pt}{6pt}{\itshape}{}% body indent
  {\sffamily\bfseries\color{SeriesMaroon}}{.}{.55em}{}
\newtheoremstyle{seriesdefinition}{6pt}{6pt}{\normalfont}{}% body indent
  {\sffamily\bfseries\color{SeriesMaroon}}{.}{.55em}{}
\theoremstyle{seriesplain}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{conjecture}[theorem]{Conjecture}
\newtheorem{criterion}[theorem]{Criterion}
\theoremstyle{seriesdefinition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{remark}[theorem]{Remark}
\newtheorem{example}[theorem]{Example}

