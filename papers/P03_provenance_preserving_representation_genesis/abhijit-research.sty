\NewDocumentCommand{\MakeResearchTitle}{}{% 
  \thispagestyle{empty}
  \vspace*{7mm}
  {\sffamily\fontsize{9.5}{11}\selectfont\color{SeriesMaroon}\MakeUppercase{\PaperKind\;\textperiodcentered\;\PaperCode\;\textperiodcentered\;\PaperVersion\;\textperiodcentered\;\PaperDate}\par}
  \vspace{3mm}{\color{SeriesMaroon}\hrule height .7pt}
  \vspace*{42mm}
  {\sffamily\bfseries\color{SeriesInk}\fontsize{29}{34}\selectfont\RaggedRight \PaperTitle\par}
  \ifx\PaperSubtitle\empty\else
    \vspace{5mm}{\itshape\color{SeriesGray}\fontsize{17}{21}\selectfont\RaggedRight \PaperSubtitle\par}
  \fi
  \vspace{16mm}
  {\sffamily\bfseries\fontsize{12.5}{15}\selectfont Abhijit Singh\par}
  \vfill
  \clearpage
  \pagestyle{series}}

\NewDocumentCommand{\MakeResearchContents}{}{% 
  \tableofcontents
  \thispagestyle{series}
  \clearpage}

\NewDocumentCommand{\MakeResearchAbstract}{m}{%
  \phantomsection\addcontentsline{toc}{section}{Abstract}
  \section*{Abstract}
  #1\par
  \vspace{1.2ex}
  {\sffamily\color{SeriesMaroon}\textbf{Keywords:}}\quad \PaperKeywords\par
  \vspace{.6ex}
  {\sffamily\color{SeriesMaroon}\textbf{Scope and status:}}\quad \PaperClassification\par
  \ifx\PaperCitation\empty\else
    \vspace{.6ex}{\sffamily\color{SeriesMaroon}\textbf{Suggested citation:}}\quad \PaperCitation\par
  \fi
  \vspace{.6ex}{\sffamily\color{SeriesMaroon}\textbf{Document status:}}\quad Research manuscript, \PaperVersion, \PaperDate.\par
  \ifx\PaperDOI\empty\else
    \vspace{.6ex}{\sffamily\color{SeriesMaroon}\textbf{DOI:}}\quad \PaperDOI\par
  \fi
  \clearpage}

\AtBeginEnvironment{thebibliography}{\phantomsection\addcontentsline{toc}{section}{References}}
