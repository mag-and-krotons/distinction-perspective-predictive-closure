\hypersetup{colorlinks=true,linkcolor=SeriesInk,citecolor=SeriesMaroon,urlcolor=SeriesMaroon,bookmarksnumbered=true}
\urlstyle{same}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5.5pt plus 1pt minus .5pt}
\setlength{\emergencystretch}{2em}
\linespread{1.035}
\setlist{leftmargin=*,itemsep=2pt,topsep=5pt,parsep=0pt}
\setlist[enumerate,1]{label=\arabic*.}
